# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# eBay (production by default; use sandbox host if EBAY_ENV=sandbox)
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_RUNAME=your-ebay-runame
EBAY_ENV=production

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Amazon shopper (used by the auto-order Playwright flow)
AMAZON_EMAIL=
AMAZON_PASSWORD=

# Default markup % applied to Amazon price when listing on eBay
DEFAULT_MARKUP_PERCENT=30
